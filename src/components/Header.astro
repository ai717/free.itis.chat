---
import { SearchModal } from './SearchModal';
import { ThemeToggle } from './ThemeToggle';
import { LanguageToggle } from './LanguageToggle';
import { NavCategories } from './NavCategories';
import { BookmarkButton } from './BookmarkControl';
import { getSearchableResources } from '../utils/resources';
import { CATEGORIES } from '../data/categories';

const searchableResources = getSearchableResources();
const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-40 w-full glass-nav transition-all">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 gap-3 sm:gap-4">
      {/* Brand Logo & Name - Strictly Single Line & Non-wrapping */}
      <div class="flex items-center gap-4 xl:gap-6 shrink-0">
        <a href="/" class="flex items-center gap-2.5 shrink-0 group">
          <img
            src="/favicon.svg"
            alt="ITIS Free"
            class="w-9 h-9 shrink-0 rounded-xl transition-opacity hover:opacity-90"
          />
          <div class="flex items-center gap-2 whitespace-nowrap">
            <span class="font-extrabold text-base sm:text-lg text-slate-900 dark:text-white tracking-tight group-hover:text-cyan-600 dark:group-hover:text-cyan-400 transition-colors">
              ITIS Free
            </span>
            <span
              class="hidden sm:inline-block text-[10px] font-semibold px-2 py-0.5 rounded-full bg-cyan-50 dark:bg-cyan-500/10 text-cyan-700 dark:text-cyan-400 border border-cyan-200 dark:border-cyan-500/20 whitespace-nowrap shrink-0"
              data-i18n-zh="开源 白嫖 避坑"
              data-i18n-en="Open Source · Free · Trap-free"
            >
              开源 白嫖 避坑
            </span>
          </div>
        </a>

        {/* Dynamic Nav Categories: shows 4 popular items, collapses remaining into dropdown */}
        <NavCategories
          client:load
          categories={CATEGORIES}
          currentPath={currentPath}
          visibleCount={4}
        />
      </div>

      {/* Right Controls: Search, Language Toggle, Theme Toggle & Submit Button */}
      <div class="flex items-center gap-2 sm:gap-2.5 shrink-0">
        {/* Full-text search modal */}
        <SearchModal client:load resources={searchableResources} />

        {/* Add to Bookmark Button */}
        <div class="shrink-0">
          <BookmarkButton client:load variant="header" />
        </div>

        {/* Language Switcher (CH / EN) */}
        <div class="shrink-0">
          <LanguageToggle client:load />
        </div>

        {/* Theme Toggle Button */}
        <div class="shrink-0">
          <ThemeToggle client:load />
        </div>

        {/* Flat Submit Resource Button */}
        <a
          href="https://github.com/ai717/free.itis.chat/issues/new?template=resource_submit.md"
          target="_blank"
          rel="noopener noreferrer"
          class="shrink-0 inline-flex items-center gap-1 px-2 sm:px-3 py-1.5 rounded-xl text-xs font-semibold bg-cyan-600 hover:bg-cyan-700 text-white transition-colors cursor-pointer whitespace-nowrap"
          title="提交新资源 / Submit Resource"
        >
          <svg viewBox="0 0 24 24" class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="5" x2="12" y2="19" />
            <line x1="5" y1="12" x2="19" y2="12" />
          </svg>
          <span class="hidden sm:inline" data-i18n-zh="提交资源" data-i18n-en="Submit">提交资源</span>
        </a>

        {/* External Link to Main itis.chat */}
        <a
          href="https://itis.chat"
          target="_blank"
          rel="noopener noreferrer"
          class="hidden md:inline-flex shrink-0 p-1.5 sm:p-2 rounded-xl text-slate-500 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-white/5 border border-transparent hover:border-slate-200 dark:hover:border-white/10 transition-colors text-xs font-medium whitespace-nowrap"
          title="ITIS Main (itis.chat)"
        >
          itis.chat ↗
        </a>
      </div>
    </div>
  </div>
</header>
