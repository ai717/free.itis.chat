---
import { SearchModal } from './SearchModal';
import { getAllResources } from '../utils/resources';
import { CATEGORIES } from '../data/categories';

const allResources = getAllResources();
const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-40 w-full glass-nav transition-all">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 gap-4">
      {/* Brand Logo & Slogan */}
      <div class="flex items-center gap-6">
        <a href="/" class="flex items-center gap-3 group">
          <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-cyan-500 to-blue-600 flex items-center justify-center shadow-lg shadow-cyan-500/20 group-hover:scale-105 transition-transform">
            <span class="text-white font-black text-lg tracking-wider">IF</span>
          </div>
          <div>
            <div class="flex items-center gap-2">
              <span class="font-bold text-lg text-white tracking-tight group-hover:text-cyan-400 transition-colors">
                ITIS Free
              </span>
              <span class="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-cyan-500/10 text-cyan-400 border border-cyan-500/20">
                开源·避坑
              </span>
            </div>
            <p class="hidden md:block text-[11px] text-slate-400 -mt-0.5">
              干净·无广告·社区驱动数字资源
            </p>
          </div>
        </a>

        {/* Navigation Categories */}
        <nav class="hidden lg:flex items-center gap-1 pl-4 border-l border-white/10 text-sm">
          <a
            href="/"
            class={`px-3 py-1.5 rounded-lg font-medium transition-colors ${
              currentPath === '/' ? 'text-cyan-400 bg-white/[0.05]' : 'text-slate-300 hover:text-white hover:bg-white/[0.03]'
            }`}
          >
            首页精选
          </a>
          {CATEGORIES.map((cat) => {
            const isActive = currentPath === `/${cat.id}` || currentPath === `/${cat.id}/`;
            return (
              <a
                href={`/${cat.id}`}
                class={`px-2.5 py-1.5 rounded-lg text-xs font-medium transition-colors ${
                  isActive ? 'text-cyan-400 bg-white/[0.05]' : 'text-slate-400 hover:text-white hover:bg-white/[0.03]'
                }`}
              >
                {cat.name.split(' ')[0]}
              </a>
            );
          })}
        </nav>
      </div>

      {/* Right Controls: Search Modal & Submit Button */}
      <div class="flex items-center gap-3">
        {/* Full-text search modal */}
        <SearchModal client:load resources={allResources} />

        {/* Submit Resource Button (Issue template) */}
        <a
          href="https://github.com/itis-chat/free.itis.chat/issues/new?template=resource_submit.md"
          target="_blank"
          rel="noopener noreferrer"
          class="hidden sm:inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl text-xs font-semibold bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 text-white shadow-md shadow-cyan-500/20 hover:shadow-cyan-500/30 transition-all cursor-pointer hover:scale-[1.02] active:scale-95"
        >
          <span>➕ 提交新资源</span>
        </a>

        {/* External Link to Main itis.chat */}
        <a
          href="https://itis.chat"
          target="_blank"
          rel="noopener noreferrer"
          class="p-2 rounded-xl text-slate-400 hover:text-white hover:bg-white/5 border border-transparent hover:border-white/10 transition-colors text-xs font-medium"
          title="访问 ITIS 主站 itis.chat"
        >
          itis.chat ↗
        </a>
      </div>
    </div>
  </div>
</header>
