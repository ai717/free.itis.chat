---
import { SearchModal } from './SearchModal';
import { ThemeToggle } from './ThemeToggle';
import { getAllResources } from '../utils/resources';
import { CATEGORIES } from '../data/categories';

const allResources = getAllResources();
const currentPath = Astro.url.pathname;

// Short labels for clean, non-wrapping header navigation
const SHORT_NAMES: Record<string, string> = {
  ai: 'AI 神器',
  adblock: '去广告',
  media: '影音媒体',
  software: '系统工具',
  books: '电子书',
  dev: '开发者',
};
---

<header class="sticky top-0 z-40 w-full glass-nav transition-all">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 gap-3 sm:gap-4">
      {/* Brand Logo & Name - Strictly Single Line & Non-wrapping */}
      <div class="flex items-center gap-4 xl:gap-6 shrink-0">
        <a href="/" class="flex items-center gap-2.5 shrink-0 group">
          <div class="w-9 h-9 shrink-0 rounded-xl bg-gradient-to-tr from-cyan-500 to-blue-600 flex items-center justify-center shadow-md shadow-cyan-500/20 group-hover:scale-105 transition-transform">
            <span class="text-white font-black text-base tracking-wider">IF</span>
          </div>
          <div class="flex items-center gap-2 whitespace-nowrap">
            <span class="font-extrabold text-base sm:text-lg text-slate-900 dark:text-white tracking-tight group-hover:text-cyan-600 dark:group-hover:text-cyan-400 transition-colors">
              ITIS Free
            </span>
            <span class="hidden sm:inline-block text-[10px] font-semibold px-2 py-0.5 rounded-full bg-cyan-50 dark:bg-cyan-500/10 text-cyan-700 dark:text-cyan-400 border border-cyan-200 dark:border-cyan-500/20">
              开源·避坑
            </span>
          </div>
        </a>

        {/* Navigation Categories - strictly whitespace-nowrap to avoid ugly line-breaks */}
        <nav class="hidden lg:flex items-center gap-1 pl-3 border-l border-slate-200 dark:border-white/10 text-xs xl:text-sm shrink-0">
          <a
            href="/"
            class={`px-2.5 py-1.5 rounded-lg font-medium whitespace-nowrap transition-colors ${
              currentPath === '/'
                ? 'text-cyan-700 dark:text-cyan-400 bg-slate-100 dark:bg-white/[0.05]'
                : 'text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-white/[0.03]'
            }`}
          >
            首页精选
          </a>
          {CATEGORIES.map((cat) => {
            const isActive = currentPath === `/${cat.id}` || currentPath === `/${cat.id}/`;
            const shortName = SHORT_NAMES[cat.id] || cat.name.split(' ')[0];
            return (
              <a
                href={`/${cat.id}`}
                class={`px-2.5 py-1.5 rounded-lg text-xs font-medium whitespace-nowrap transition-colors ${
                  isActive
                    ? 'text-cyan-700 dark:text-cyan-400 bg-slate-100 dark:bg-white/[0.05]'
                    : 'text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-white/[0.03]'
                }`}
              >
                {shortName}
              </a>
            );
          })}
        </nav>
      </div>

      {/* Right Controls: Search, Theme Toggle, Submit Button & External Link */}
      <div class="flex items-center gap-2 sm:gap-2.5 shrink-0">
        {/* Full-text search modal */}
        <SearchModal client:load resources={allResources} />

        {/* Theme Toggle Button */}
        <div class="shrink-0">
          <ThemeToggle client:load />
        </div>

        {/* Submit Resource Button - Strictly Single Line */}
        <a
          href="https://github.com/ai717/free.itis.chat/issues/new?template=resource_submit.md"
          target="_blank"
          rel="noopener noreferrer"
          class="shrink-0 inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-semibold bg-gradient-to-r from-cyan-600 to-blue-600 dark:from-cyan-500 dark:to-blue-600 hover:opacity-95 text-white shadow-xs transition-all cursor-pointer whitespace-nowrap active:scale-95"
        >
          <span>➕ 提交资源</span>
        </a>

        {/* External Link to Main itis.chat */}
        <a
          href="https://itis.chat"
          target="_blank"
          rel="noopener noreferrer"
          class="shrink-0 p-1.5 sm:p-2 rounded-xl text-slate-500 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-white/5 border border-transparent hover:border-slate-200 dark:hover:border-white/10 transition-colors text-xs font-medium whitespace-nowrap"
          title="访问 ITIS 主站 itis.chat"
        >
          itis.chat ↗
        </a>
      </div>
    </div>
  </div>
</header>
