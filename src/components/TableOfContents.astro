---
import { CATEGORIES } from '../data/categories';
import { getAllResources } from '../utils/resources';
import CategoryIcon from './icons/CategoryIcon.astro';

interface Props {
  activeCategory?: string;
}

const { activeCategory = '' } = Astro.props;

const all = getAllResources();
const categoryCounts = CATEGORIES.map((cat) => ({
  ...cat,
  count: all.filter((item) => item.category === cat.id).length,
}));

const activeCatObj = CATEGORIES.find((c) => c.id === activeCategory);
const activeNameZh = activeCategory === 'home' || activeCategory === '' ? '首页精选' : (activeCatObj?.name || '分类索引');
const activeNameEn = activeCategory === 'home' || activeCategory === '' ? 'Featured' : (activeCatObj?.enName || 'Categories');
---

{/* Desktop Sidebar (lg and above: fixed left sidebar) */}
<aside class="hidden lg:block w-64 shrink-0">
  <div class="sticky top-20 p-4 rounded-2xl bg-white dark:bg-white/[0.02] border border-slate-200 dark:border-white/10 space-y-4">
    <div class="flex items-center justify-between pb-2 border-b border-slate-200/80 dark:border-white/5">
      <span class="text-xs font-bold text-slate-700 dark:text-slate-300 tracking-wider uppercase flex items-center gap-1.5">
        <svg viewBox="0 0 24 24" class="w-3.5 h-3.5 text-cyan-600 dark:text-cyan-400" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" />
        </svg>
        <span data-i18n-zh="分类索引" data-i18n-en="Categories">分类索引</span>
      </span>
      <span
        class="text-[11px] font-mono text-cyan-700 dark:text-cyan-400 bg-cyan-50 dark:bg-cyan-500/10 px-2 py-0.5 rounded-full border border-cyan-200 dark:border-cyan-500/20"
        data-i18n-zh={`共 ${all.length} 条`}
        data-i18n-en={`${all.length} items`}
      >
        共 {all.length} 条
      </span>
    </div>

    <nav class="space-y-0.5 max-h-[calc(100vh-12rem)] overflow-y-auto no-scrollbar">
      {/* Home link */}
      <a
        href="/"
        class={`group flex items-center justify-between px-2.5 py-1.5 rounded-xl text-xs font-medium transition-all ${
          activeCategory === '' || activeCategory === 'home'
            ? 'bg-cyan-50 dark:bg-cyan-500/10 text-cyan-700 dark:text-cyan-400 font-semibold border border-cyan-200 dark:border-cyan-500/20'
            : 'text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-white/[0.04]'
        }`}
      >
        <span class="flex items-center gap-2">
          <svg viewBox="0 0 24 24" class={`w-3.5 h-3.5 ${
            activeCategory === '' || activeCategory === 'home' ? 'text-cyan-600 dark:text-cyan-400 fill-cyan-400/20' : 'text-slate-400'
          }`} fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
          </svg>
          <span data-i18n-zh="首页精选" data-i18n-en="Featured Top">首页精选</span>
        </span>
        <span
          class="text-[10px] font-mono text-cyan-600 dark:text-cyan-400 font-semibold px-1.5 py-0.5 rounded bg-cyan-50 dark:bg-cyan-500/10 border border-cyan-200/60 dark:border-cyan-500/20"
          data-i18n-zh="100款"
          data-i18n-en="100"
        >
          100款
        </span>
      </a>

      {categoryCounts.map((cat) => {
        const isActive = activeCategory === cat.id;
        return (
          <a
            href={`/${cat.id}`}
            class={`group flex items-center justify-between px-2.5 py-1.5 rounded-xl text-xs font-medium transition-all ${
              isActive
                ? 'bg-cyan-50 dark:bg-cyan-500/10 text-cyan-700 dark:text-cyan-400 font-semibold border border-cyan-200 dark:border-cyan-500/20'
                : 'text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-white/[0.04]'
            }`}
          >
            <span class="flex items-center gap-2 min-w-0">
              <CategoryIcon
                id={cat.id}
                class={`w-3.5 h-3.5 shrink-0 transition-colors ${
                  isActive
                    ? 'text-cyan-600 dark:text-cyan-400'
                    : 'text-slate-400 dark:text-slate-500 group-hover:text-cyan-600 dark:group-hover:text-cyan-400'
                }`}
              />
              <span class="truncate" data-i18n-zh={cat.name} data-i18n-en={cat.enName}>{cat.name}</span>
            </span>
            <span class="text-[10px] font-mono text-slate-400 px-1.5 py-0.5 rounded bg-slate-100 dark:bg-white/[0.02] shrink-0 ml-2">
              {cat.count}
            </span>
          </a>
        );
      })}
    </nav>

    <div class="pt-3 border-t border-slate-200/80 dark:border-white/5 text-[11px] text-slate-500 dark:text-slate-400 leading-relaxed">
      <span data-i18n-zh="提示：按" data-i18n-en="Tip: Press">提示：按</span>
      <kbd class="px-1.5 py-0.5 rounded bg-slate-100 dark:bg-white/5 border border-slate-300 dark:border-white/10 font-mono text-slate-600 dark:text-slate-300">Cmd+K</kbd>
      <span data-i18n-zh="随时唤起全站毫秒级搜索。" data-i18n-en="to search all resources instantly.">随时唤起全站毫秒级搜索。</span>
    </div>
  </div>
</aside>

{/* Mobile Category Nav (below lg screens: sleek horizontal scroll pills + expandable drawer) */}
<div class="lg:hidden w-full mb-3">
  <div class="rounded-2xl bg-white dark:bg-white/[0.02] border border-slate-200 dark:border-white/10 p-2.5 shadow-2xs">
    {/* Mobile Header Row: Active Category + Expand Button */}
    <div class="flex items-center justify-between pb-2 mb-2 border-b border-slate-100 dark:border-white/5 px-1">
      <div class="flex items-center gap-2 min-w-0">
        <span class="w-2 h-2 rounded-full bg-cyan-500 shrink-0"></span>
        <span class="text-xs font-bold text-slate-800 dark:text-slate-200 truncate" data-i18n-zh={activeNameZh} data-i18n-en={activeNameEn}>
          {activeNameZh}
        </span>
      </div>
      <button
        id="mobile-cat-expand-btn"
        type="button"
        class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-[11px] font-medium text-cyan-700 dark:text-cyan-300 bg-cyan-50 dark:bg-cyan-500/10 border border-cyan-200/80 dark:border-cyan-500/20 transition-all cursor-pointer"
        aria-expanded="false"
      >
        <span id="mobile-cat-btn-text" data-i18n-zh="全部 23 分类 ▾" data-i18n-en="All Categories ▾">全部 23 分类 ▾</span>
      </button>
    </div>

    {/* Horizontal Scrollable Pills */}
    <nav class="flex items-center gap-1.5 overflow-x-auto no-scrollbar py-1 scroll-smooth touch-pan-x -mx-1 px-1">
      <a
        href="/"
        class={`shrink-0 inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-medium whitespace-nowrap transition-colors ${
          activeCategory === '' || activeCategory === 'home'
            ? 'bg-cyan-600 text-white font-semibold shadow-xs'
            : 'bg-slate-100 dark:bg-white/[0.04] text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-white/[0.08]'
        }`}
      >
        <span>⭐</span>
        <span data-i18n-zh="首页精选" data-i18n-en="Featured">首页精选</span>
      </a>

      {categoryCounts.map((cat) => {
        const isActive = activeCategory === cat.id;
        return (
          <a
            href={`/${cat.id}`}
            class={`shrink-0 inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-xl text-xs font-medium whitespace-nowrap transition-colors ${
              isActive
                ? 'bg-cyan-600 text-white font-semibold shadow-xs'
                : 'bg-slate-100 dark:bg-white/[0.04] text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-white/[0.08]'
            }`}
          >
            <CategoryIcon id={cat.id} class={`w-3.5 h-3.5 ${isActive ? 'text-white' : 'text-slate-500'}`} />
            <span data-i18n-zh={cat.name} data-i18n-en={cat.enName}>{cat.name}</span>
          </a>
        );
      })}
    </nav>

    {/* Expandable 2-Column Grid on Mobile */}
    <div id="mobile-cat-grid" class="hidden pt-3 border-t border-slate-100 dark:border-white/5 grid grid-cols-2 gap-1.5 mt-2 animate-in fade-in duration-200">
      <a
        href="/"
        class={`flex items-center justify-between p-2 rounded-xl text-xs font-medium ${
          activeCategory === '' || activeCategory === 'home'
            ? 'bg-cyan-50 dark:bg-cyan-500/10 text-cyan-700 dark:text-cyan-400 font-bold border border-cyan-200 dark:border-cyan-500/20'
            : 'bg-slate-50 dark:bg-white/[0.02] text-slate-700 dark:text-slate-300'
        }`}
      >
        <span class="flex items-center gap-1.5 truncate">
          <span>⭐</span>
          <span data-i18n-zh="首页精选" data-i18n-en="Featured">首页精选</span>
        </span>
        <span class="text-[10px] font-mono text-cyan-600 shrink-0">100</span>
      </a>

      {categoryCounts.map((cat) => {
        const isActive = activeCategory === cat.id;
        return (
          <a
            href={`/${cat.id}`}
            class={`flex items-center justify-between p-2 rounded-xl text-xs font-medium ${
              isActive
                ? 'bg-cyan-50 dark:bg-cyan-500/10 text-cyan-700 dark:text-cyan-400 font-bold border border-cyan-200 dark:border-cyan-500/20'
                : 'bg-slate-50 dark:bg-white/[0.02] text-slate-700 dark:text-slate-300'
            }`}
          >
            <span class="flex items-center gap-1.5 truncate">
              <CategoryIcon id={cat.id} class={`w-3.5 h-3.5 shrink-0 ${isActive ? 'text-cyan-600 dark:text-cyan-400' : 'text-slate-400'}`} />
              <span class="truncate" data-i18n-zh={cat.name} data-i18n-en={cat.enName}>{cat.name}</span>
            </span>
            <span class="text-[10px] font-mono text-slate-400 shrink-0 ml-1">{cat.count}</span>
          </a>
        );
      })}
    </div>
  </div>
</div>

<script is:inline>
  (() => {
    const btn = document.getElementById('mobile-cat-expand-btn');
    const grid = document.getElementById('mobile-cat-grid');
    const text = document.getElementById('mobile-cat-btn-text');
    if (!btn || !grid || !text) return;

    btn.addEventListener('click', () => {
      const isHidden = grid.classList.contains('hidden');
      if (isHidden) {
        grid.classList.remove('hidden');
        btn.setAttribute('aria-expanded', 'true');
        text.textContent = '收起分类 ▴';
      } else {
        grid.classList.add('hidden');
        btn.setAttribute('aria-expanded', 'false');
        text.textContent = '全部 23 分类 ▾';
      }
    });
  })();
</script>
