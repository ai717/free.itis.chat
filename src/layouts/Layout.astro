---
import Header from '../components/Header.astro';
import { BookmarkNewUserPrompt } from '../components/BookmarkControl';
import { PlanetFloatingAd } from '../components/PlanetFloatingAd';
import '../styles/global.css';

interface Props {
  title?: string;
  titleEn?: string;
  description?: string;
  descriptionEn?: string;
  keywords?: string;
  schema?: any;
}

const {
  title = 'ITIS Free 免费开源数字资源导航',
  titleEn = 'ITIS Free - Digital Free Resources Navigation Hub',
  description = '互联网上最大的干净、无广告、社区驱动的中文数字免费资源导航，开源！白嫖！避坑！',
  descriptionEn = 'The cleanest, ad-free, community-driven digital free resource navigation wiki. 100% Free · Open Source · Trap-free.',
  keywords,
  schema,
} = Astro.props;

const siteUrl = 'https://free.itis.chat';
const cleanPath = Astro.url.pathname.replace(/\/+$/, '') || '';
const canonicalUrl = cleanPath ? `${siteUrl}${cleanPath}/` : `${siteUrl}/`;

const defaultKeywords =
  'FMHY中文版, 免费开源软件, 数字资源导航, 开源AI工具, 去广告插件, 免费影视, 免费电子书, 开发者神器, 避坑指南, 白嫖网站, GitHub开源项目, free media heck yeah, open source software, adblock, privacy tools, local llm, free ebooks, self-hosted apps';
---

<!doctype html>
<html lang="zh-CN" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title id="site-title" data-title-zh={title} data-title-en={titleEn}>{title}</title>
    <meta id="site-meta-desc" name="description" data-desc-zh={description} data-desc-en={descriptionEn} content={description} />

    {/* Canonical URL */}
    <link rel="canonical" href={canonicalUrl} />

    {/* Search Engine Robots & Crawling Directives */}
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="googlebot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <meta name="keywords" content={keywords || defaultKeywords} />
    <meta name="author" content="ITIS Free Community" />
    <meta name="publisher" content="https://free.itis.chat" />

    {/* Open Graph / Facebook */}
    <meta property="og:site_name" content="ITIS Free" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:locale:alternate" content="en_US" />
    <meta property="og:image" content={`${siteUrl}/og-image.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="ITIS Free - 免费开源数字资源导航" />

    {/* Twitter Card */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}/og-image.png`} />
    <meta name="twitter:image:alt" content="ITIS Free - 免费开源数字资源导航" />

    {/* Performance: DNS prefetch & Preconnect */}
    <link rel="dns-prefetch" href="https://github.com" />
    <link rel="preconnect" href="https://github.com" crossorigin />

    {/* Structured Data: JSON-LD Schema.org for Google Search */}
    {schema && (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    )}

    {/* Pre-theme & Pre-language initialization to prevent flash */}
    <script is:inline>
      // Theme initialization (Default 'light')
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        return 'light';
      })();
      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }

      // Language initialization (Automatic based on user environment)
      const lang = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('lang')) {
          return localStorage.getItem('lang');
        }
        const browserLang = (navigator.language || (navigator.languages && navigator.languages[0]) || 'zh').toLowerCase();
        return browserLang.startsWith('zh') ? 'zh' : 'en';
      })();
      document.documentElement.lang = lang === 'zh' ? 'zh-CN' : 'en';
      document.documentElement.setAttribute('data-lang', lang);

      // Early DOM updater for static text, title and meta description
      function applyLangTexts() {
        const currentLang = document.documentElement.getAttribute('data-lang') || 'zh';

        const titleEl = document.getElementById('site-title');
        if (titleEl) {
          const t = currentLang === 'en' ? titleEl.getAttribute('data-title-en') : titleEl.getAttribute('data-title-zh');
          if (t) document.title = t;
        }

        const descEl = document.getElementById('site-meta-desc');
        if (descEl) {
          const d = currentLang === 'en' ? descEl.getAttribute('data-desc-en') : descEl.getAttribute('data-desc-zh');
          if (d) descEl.setAttribute('content', d);
        }

        const dualNodes = document.querySelectorAll('[data-i18n-zh]');
        dualNodes.forEach((node) => {
          const text = currentLang === 'en' ? node.getAttribute('data-i18n-en') : node.getAttribute('data-i18n-zh');
          if (text !== null && text !== undefined) node.textContent = text;
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', applyLangTexts);
      } else {
        applyLangTexts();
      }
    </script>
  </head>
  <body class="bg-slate-50 dark:bg-[#090D16] text-slate-900 dark:text-slate-100 min-h-screen flex flex-col relative antialiased selection:bg-cyan-500/20 selection:text-cyan-800 dark:selection:text-cyan-200">
    {/* Header */}
    <Header />

    {/* Main Content Area */}
    <main class="flex-1 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-10">
      <slot />
    </main>

    {/* Footer */}
    <footer class="w-full border-t border-slate-200 dark:border-white/5 bg-white/80 dark:bg-[#070A12]/80 backdrop-blur-xl py-10">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col lg:flex-row items-center justify-between gap-6">
        {/* Left Brand & Slogan (Strictly preserve brand inline, prevent squeezing) */}
        <div class="flex flex-col md:flex-row items-center gap-3 text-center md:text-left min-w-0">
          <div class="flex items-center justify-center sm:justify-start gap-2 shrink-0 whitespace-nowrap">
            <span class="font-bold text-base text-slate-900 dark:text-white shrink-0 whitespace-nowrap">
              ITIS Free
            </span>
            <span class="text-xs px-2.5 py-0.5 rounded-full bg-cyan-50 dark:bg-cyan-500/10 text-cyan-600 dark:text-cyan-400 border border-cyan-200 dark:border-cyan-500/20 shrink-0 whitespace-nowrap">
              Community Driven
            </span>
          </div>
          <span class="hidden md:inline text-slate-300 dark:text-slate-700 shrink-0">|</span>
          <p
            class="text-xs text-slate-500 dark:text-slate-400 font-normal leading-relaxed text-center md:text-left"
            data-i18n-zh="互联网上最大的干净、无广告、社区驱动的中文数字免费资源导航，开源！白嫖！避坑！"
            data-i18n-en="The cleanest, ad-free, community-driven digital free resource navigation wiki. 100% Free · Open Source · Trap-free."
          >
            互联网上最大的干净、无广告、社区驱动的中文数字免费资源导航，开源！白嫖！避坑！
          </p>
        </div>

        {/* Right Links (FMHY removed per request) */}
        <div class="flex items-center gap-6 text-xs text-slate-500 dark:text-slate-400 shrink-0">
          <a
            href="https://github.com/ai717/free.itis.chat"
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-cyan-600 dark:hover:text-cyan-400 transition-colors"
            data-i18n-zh="GitHub 仓库 & Fork PR ↗"
            data-i18n-en="GitHub Repo & Fork PR ↗"
          >
            GitHub 仓库 & Fork PR ↗
          </a>
          <a
            href="https://github.com/ai717/free.itis.chat/issues/new?template=resource_submit.md"
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-cyan-600 dark:hover:text-cyan-400 transition-colors"
            data-i18n-zh="提交新资源 (Issue) ↗"
            data-i18n-en="Submit New Resource ↗"
          >
            提交新资源 (Issue) ↗
          </a>
          <a
            href="https://itis.chat"
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-cyan-600 dark:hover:text-cyan-400 transition-colors"
            data-i18n-zh="ITIS 主站 ↗"
            data-i18n-en="ITIS Main ↗"
          >
            ITIS 主站 ↗
          </a>
        </div>
      </div>

      {/* Official Bottom Line */}
      <div
        class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-6 pt-6 border-t border-slate-200/60 dark:border-white/[0.03] text-center text-xs text-slate-500 dark:text-slate-400"
        data-i18n-zh="© 2026 ITIS Free. 互联网上最大的干净、无广告、社区驱动的中文数字免费资源导航，开源！白嫖！避坑！"
        data-i18n-en="© 2026 ITIS Free. The cleanest, ad-free, community-driven digital free resource directory. 100% Free · Open Source · Trap-free."
      >
        © 2026 ITIS Free. 互联网上最大的干净、无广告、社区驱动的中文数字免费资源导航，开源！白嫖！避坑！
      </div>
    </footer>

    {/* New User Bookmark Prompt Notification */}
    <BookmarkNewUserPrompt client:idle />

    {/* itis.chat AI Planet Floating Side Ad */}
    <PlanetFloatingAd client:idle />
  </body>
</html>
