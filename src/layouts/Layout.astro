---
import Header from '../components/Header.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'ITIS Free - 互联网上干净、无广告、社区驱动的中文数字免费资源导航',
  description = 'ITIS Free (free.itis.chat) 是中文极客与数字创作者的白嫖避坑宝典。零广告、纯开源、极客白嫖、社区驱动、安全避坑。对标并汉化 FMHY 精华，收录 AI 神器、去广告、影视音乐、离线软件与电子书文献。',
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />

    {/* Open Graph / Social Media */}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://free.itis.chat" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    {/* Preconnect fonts if needed */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>
  <body class="bg-[#090D16] text-slate-100 min-h-screen flex flex-col relative antialiased selection:bg-cyan-500/30 selection:text-cyan-200">
    {/* Ambient Glow Lights in Background */}
    <div class="fixed top-[-100px] left-1/4 glow-spot-cyan -z-10 opacity-70"></div>
    <div class="fixed top-[300px] right-10 glow-spot-blue -z-10 opacity-50"></div>
    <div class="fixed bottom-0 left-10 glow-spot-blue -z-10 opacity-30"></div>

    {/* Header */}
    <Header />

    {/* Main Content Area */}
    <main class="flex-1 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
      <slot />
    </main>

    {/* Footer */}
    <footer class="w-full border-t border-white/5 bg-[#070A12]/80 backdrop-blur-xl py-12">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row items-center justify-between gap-6">
        <div>
          <div class="flex items-center gap-2 mb-2">
            <span class="font-bold text-base text-white">ITIS Free</span>
            <span class="text-xs px-2 py-0.5 rounded-full bg-cyan-500/10 text-cyan-400 border border-cyan-500/20">
              Community Driven
            </span>
          </div>
          <p class="text-xs text-slate-400 max-w-md leading-relaxed">
            互联网上最大的干净、无广告、社区驱动的中文数字免费资源导航。<br />
            开源！白嫖！避坑！零商业推广，纯靠极客自愿共建。
          </p>
        </div>

        <div class="flex flex-col sm:flex-row items-center gap-6 text-xs text-slate-400">
          <a
            href="https://github.com/itis-chat/free.itis.chat"
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-cyan-400 transition-colors"
          >
            GitHub 仓库 & Fork PR ↗
          </a>
          <a
            href="https://github.com/itis-chat/free.itis.chat/issues/new?template=resource_submit.md"
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-cyan-400 transition-colors"
          >
            提交新资源 (Issue) ↗
          </a>
          <a
            href="https://fmhy.net"
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-cyan-400 transition-colors"
          >
            致敬 FMHY (FreeMediaHeckYeah) ↗
          </a>
          <a
            href="https://itis.chat"
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-cyan-400 transition-colors"
          >
            ITIS 主站 ↗
          </a>
        </div>
      </div>
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-6 pt-6 border-t border-white/[0.03] text-center text-[11px] text-slate-400">
        © {new Date().getFullYear()} ITIS Free. All rights reserved. 保护隐私，向一切虚假套路与诱导广告说不。
      </div>
    </footer>
  </body>
</html>
