---
import Layout from '../layouts/Layout.astro';
import { ResourceList } from '../components/ResourceList';
import { getResourcesByCategory } from '../utils/resources';
import { CATEGORIES } from '../data/categories';

export function getStaticPaths() {
  return CATEGORIES.map((cat) => ({
    params: { category: cat.id },
    props: { categoryMeta: cat },
  }));
}

const { categoryMeta } = Astro.props;
const resources = getResourcesByCategory(categoryMeta.id);
---

<Layout
  title={`${categoryMeta.name} - ITIS Free 开源免费导航`}
  description={categoryMeta.description}
>
  {/* Category Hero */}
  <section class="py-6 border-b border-slate-200/90 dark:border-white/5 mb-6">
    <div class="flex items-center gap-2 text-xs font-semibold text-cyan-600 dark:text-cyan-400 mb-2">
      <a href="/" class="hover:underline text-slate-500 dark:text-slate-400">首页</a>
      <span class="text-slate-400 dark:text-slate-600">/</span>
      <span>{categoryMeta.enName}</span>
    </div>

    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight flex items-center gap-2.5">
          <span class="w-3 h-3 rounded-full bg-cyan-500"></span>
          <span>{categoryMeta.name}</span>
          <span class="text-xs font-mono font-normal text-slate-500 dark:text-slate-400">({categoryMeta.enName})</span>
        </h1>
        <p class="text-slate-600 dark:text-slate-400 text-xs sm:text-sm mt-1 leading-relaxed">
          {categoryMeta.description}
        </p>
      </div>

      <div class="flex items-center gap-3 shrink-0">
        <a
          href="https://github.com/ai717/free.itis.chat/issues/new?template=resource_submit.md"
          target="_blank"
          rel="noopener noreferrer"
          class="px-3.5 py-1.5 rounded-xl text-xs font-semibold bg-white dark:bg-white/5 hover:bg-slate-50 dark:hover:bg-white/10 text-cyan-700 dark:text-cyan-300 border border-slate-200 dark:border-white/10 hover:border-cyan-500/40 transition-all shadow-xs"
        >
          ➕ 向本分类推荐新资源
        </a>
      </div>
    </div>
  </section>

  {/* Category Dense List */}
  <section>
    <ResourceList
      client:load
      resources={resources}
      activeCategory={categoryMeta.id}
      groupByCategory={false}
    />
  </section>
</Layout>
