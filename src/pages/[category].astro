---
import Layout from '../layouts/Layout.astro';
import { BentoGrid } from '../components/BentoGrid';
import { getResourcesByCategory } from '../utils/resources';
import { CATEGORIES } from '../data/categories';

export function getStaticPaths() {
  return CATEGORIES.map((cat) => ({
    params: { category: cat.id },
    props: { categoryMeta: cat },
  }));
}

const { categoryMeta } = Astro.props;
const resources = getResourcesByCategory(categoryMeta.id);
---

<Layout
  title={`${categoryMeta.name} - ITIS Free 开源免费导航`}
  description={categoryMeta.description}
>
  {/* Category Hero */}
  <section class="py-8 sm:py-12 border-b border-white/5 mb-10">
    <div class="flex items-center gap-2 text-xs font-semibold text-cyan-400 mb-3">
      <a href="/" class="hover:underline text-slate-400">首页</a>
      <span class="text-slate-600">/</span>
      <span>{categoryMeta.enName}</span>
    </div>

    <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
      <div>
        <div class="flex items-center gap-3 mb-2">
          <div class={`w-10 h-10 rounded-xl bg-gradient-to-br ${categoryMeta.gradient} flex items-center justify-center text-white font-bold text-lg shadow-lg`}>
            {categoryMeta.name.slice(0, 1)}
          </div>
          <h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
            {categoryMeta.name}
          </h1>
        </div>
        <p class="text-slate-400 text-sm sm:text-base max-w-2xl mt-1 leading-relaxed">
          {categoryMeta.description}
        </p>
      </div>

      <div class="flex items-center gap-3">
        <a
          href="https://github.com/ai717/free.itis.chat/issues/new?template=resource_submit.md"
          target="_blank"
          rel="noopener noreferrer"
          class="px-4 py-2 rounded-xl text-xs font-semibold bg-white/5 hover:bg-white/10 text-cyan-300 border border-white/10 hover:border-cyan-500/30 transition-all"
        >
          ➕ 向本分类推荐新资源
        </a>
      </div>
    </div>
  </section>

  {/* Category Bento Grid */}
  <section>
    <div class="flex items-center justify-between mb-6">
      <h2 class="text-xl font-bold text-slate-100 flex items-center gap-2">
        <span>收录清单</span>
        <span class="text-xs px-2 py-0.5 rounded-full bg-slate-800 text-slate-400 font-mono">
          {resources.length} 项
        </span>
      </h2>
    </div>

    <BentoGrid client:load resources={resources} defaultCategory={categoryMeta.id} />
  </section>
</Layout>
