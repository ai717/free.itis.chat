---
import Layout from '../layouts/Layout.astro';
import { ResourceList } from '../components/ResourceList';
import TableOfContents from '../components/TableOfContents.astro';
import { getFeaturedResources } from '../utils/resources';

const featuredResources = getFeaturedResources();
---

<Layout
  title="ITIS Free 免费开源数字资源导航"
  description="互联网上最大的干净、无广告、社区驱动的中文数字免费资源导航，开源！白嫖！避坑！"
>
  {/* FMHY Style Top Minimal Header Banner */}
  <section class="py-6 border-b border-slate-200/90 dark:border-white/5 mb-8">
    <div class="flex flex-col gap-4">
      <div>
        <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-cyan-50 dark:bg-cyan-500/10 border border-cyan-200 dark:border-cyan-500/20 text-cyan-700 dark:text-cyan-400 text-xs font-semibold mb-2">
          <svg viewBox="0 0 24 24" class="w-3.5 h-3.5 text-cyan-600 dark:text-cyan-400" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" />
          </svg>
          <span data-i18n-zh="社区驱动 · 开源白嫖避坑维基" data-i18n-en="Community Driven · The Anti-Bullshit Free Wiki">社区驱动 · 开源白嫖避坑维基</span>
        </div>
        <h1
          class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight"
          data-i18n-zh="ITIS Free 免费开源数字资源导航"
          data-i18n-en="ITIS Free - Digital Free Resources Navigation Hub"
        >
          ITIS Free 免费开源数字资源导航
        </h1>
        <p
          class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 mt-1.5 font-normal leading-relaxed"
          data-i18n-zh="互联网上最大的干净、无广告、社区驱动的中文数字免费资源导航，开源！白嫖！避坑！"
          data-i18n-en="The cleanest, ad-free, community-driven digital free resource navigation wiki. 100% Free · Open Source · Trap-free."
        >
          互联网上最大的干净、无广告、社区驱动的中文数字免费资源导航，开源！白嫖！避坑！
        </p>
      </div>

      {/* Philosophy badges directly under slogan */}
      <div class="flex items-center gap-2 flex-wrap text-xs text-slate-600 dark:text-slate-400">
        <span
          class="px-2.5 py-1 rounded-lg bg-white dark:bg-white/[0.03] border border-slate-200 dark:border-white/5 text-emerald-700 dark:text-emerald-400"
          data-i18n-zh="✓ 零商业广告"
          data-i18n-en="✓ Zero Commercial Ads"
        >
          ✓ 零商业广告
        </span>
        <span
          class="px-2.5 py-1 rounded-lg bg-white dark:bg-white/[0.03] border border-slate-200 dark:border-white/5 text-cyan-700 dark:text-cyan-400"
          data-i18n-zh="✓ 开源优先"
          data-i18n-en="✓ Open Source First"
        >
          ✓ 开源优先
        </span>
        <span
          class="px-2.5 py-1 rounded-lg bg-white dark:bg-white/[0.03] border border-slate-200 dark:border-white/5 text-amber-700 dark:text-amber-400"
          data-i18n-zh="✓ 避坑提示"
          data-i18n-en="✓ Trap Warnings"
        >
          ✓ 避坑提示
        </span>
        <a
          href="https://github.com/ai717/free.itis.chat/issues/new?template=resource_submit.md"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg bg-cyan-50 dark:bg-cyan-500/10 hover:bg-cyan-100 dark:hover:bg-cyan-500/20 text-cyan-700 dark:text-cyan-300 border border-cyan-200 dark:border-cyan-500/20 transition-colors font-medium whitespace-nowrap"
        >
          <svg viewBox="0 0 24 24" class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="5" x2="12" y2="19" />
            <line x1="5" y1="12" x2="19" y2="12" />
          </svg>
          <span data-i18n-zh="提交推荐" data-i18n-en="Submit Resource">提交推荐</span>
        </a>
      </div>
    </div>
  </section>

  {/* Main Layout: Left TOC Sidebar + Right Featured Showcase */}
  <div class="flex flex-col lg:flex-row items-start gap-8">
    {/* Left Category Index Sidebar */}
    <TableOfContents activeCategory="home" />

    {/* Right Main Content: Directly Show Featured Gems */}
    <div class="flex-1 min-w-0 w-full space-y-4">
      <div class="flex items-center justify-between pb-2 border-b border-slate-200 dark:border-white/10">
        <div class="flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-cyan-500"></span>
          <h2
            class="text-lg font-bold text-slate-900 dark:text-white tracking-tight"
            data-i18n-zh="全站重磅精选 (Featured Top)"
            data-i18n-en="Featured Standouts & Must-Haves"
          >
            全站重磅精选 (Featured Top)
          </h2>
        </div>
        <span
          class="text-xs text-slate-500 dark:text-slate-400"
          data-i18n-zh="高星必装 · 零广告纯开源 · 点击左侧探索更多分类"
          data-i18n-en="Top Starred · Ad-Free & Open-Source · Click sidebar to explore"
        >
          高星必装 · 零广告纯开源 · 点击左侧探索更多分类
        </span>
      </div>

      <ResourceList
        client:load
        resources={featuredResources}
        groupByCategory={false}
      />
    </div>
  </div>
</Layout>
