---
import Layout from '../layouts/Layout.astro';
import { ResourceList } from '../components/ResourceList';
import TableOfContents from '../components/TableOfContents.astro';
import { getAllResources } from '../utils/resources';
import { CATEGORIES } from '../data/categories';

const allResources = getAllResources();
---

<Layout
  title="ITIS Free 免费开源数字资源导航"
  description="互联网上最大的干净、无广告、社区驱动的中文数字免费资源导航，开源！白嫖！避坑！"
>
  {/* FMHY Style Top Minimal Header Banner */}
  <section class="py-6 border-b border-slate-200/90 dark:border-white/5 mb-8">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div>
        <div class="inline-flex items-center gap-2 px-2.5 py-0.5 rounded-full bg-cyan-50 dark:bg-cyan-500/10 border border-cyan-200 dark:border-cyan-500/20 text-cyan-700 dark:text-cyan-400 text-xs font-semibold mb-2">
          <span>⚡ 社区驱动 · 开源白嫖避坑维基</span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">
          ITIS Free 免费开源数字资源导航
        </h1>
        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 mt-1 max-w-2xl font-normal leading-relaxed">
          互联网上最大的干净、无广告、社区驱动的中文数字免费资源导航，开源！白嫖！避坑！
        </p>
      </div>

      {/* Philosophy badges */}
      <div class="flex items-center gap-2 flex-wrap text-xs text-slate-600 dark:text-slate-400">
        <span class="px-2.5 py-1 rounded-lg bg-white dark:bg-white/[0.03] border border-slate-200 dark:border-white/5 text-emerald-700 dark:text-emerald-400">✓ 零商业广告</span>
        <span class="px-2.5 py-1 rounded-lg bg-white dark:bg-white/[0.03] border border-slate-200 dark:border-white/5 text-cyan-700 dark:text-cyan-400">✓ 开源优先</span>
        <span class="px-2.5 py-1 rounded-lg bg-white dark:bg-white/[0.03] border border-slate-200 dark:border-white/5 text-amber-700 dark:text-amber-400">✓ 避坑提示</span>
        <a
          href="https://github.com/ai717/free.itis.chat/issues/new?template=resource_submit.md"
          target="_blank"
          rel="noopener noreferrer"
          class="px-3 py-1 rounded-lg bg-cyan-50 dark:bg-cyan-500/10 hover:bg-cyan-100 dark:hover:bg-cyan-500/20 text-cyan-700 dark:text-cyan-300 border border-cyan-200 dark:border-cyan-500/20 transition-colors font-medium whitespace-nowrap"
        >
          ➕ 提交推荐
        </a>
      </div>
    </div>
  </section>

  {/* Main Wiki Layout: Left Sidebar TOC + Right Dense Resource List */}
  <div class="flex flex-col lg:flex-row items-start gap-8">
    {/* Left Sticky Table of Contents */}
    <TableOfContents />

    {/* Right Main Grouped Dense List */}
    <div class="flex-1 min-w-0 w-full">
      <ResourceList
        client:load
        resources={allResources}
        categories={CATEGORIES}
        groupByCategory={true}
      />
    </div>
  </div>
</Layout>
